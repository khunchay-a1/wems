{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "PRISMA_*",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "S3_*",
    "SMTP_*",
    "GOTENBERG_URL",
    "JWT_*",
    "APP_ENCRYPTION_KEY",
    "NODE_ENV",
    "CI",
    "PLAYWRIGHT_*",
    "NEXT_PUBLIC_*",
    "API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
