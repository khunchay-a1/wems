{
  "name": "@wems/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier configuration for the WEMS monorepo",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.9.0 <6.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
