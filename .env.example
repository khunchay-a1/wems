# WEMS — environment variables (docs/02-architecture.md §11)
# Copy to .env for local development. Never commit real secrets (CLAUDE.md rule 11).
# Values below match the local stack in infra/docker-compose.yml (P0-02).

NODE_ENV=development

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql://wems:wems@localhost:5432/wems
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, S3/R2 in production) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=wems-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true

# --- Auth (docs/06-security.md §2) -----------------------------------------
# >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=900
REFRESH_TTL_WEB_DAYS=7
REFRESH_TTL_MOBILE_DAYS=30
# AES-256-GCM key for TOTP secrets: base64 of exactly 32 bytes (`openssl rand -base64 32`)
APP_ENCRYPTION_KEY=

# --- URLs ------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000

# --- Mail (Mailpit locally: UI at http://localhost:8025) --------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WEMS <no-reply@wems.local>"

# --- PDF -------------------------------------------------------------------
GOTENBERG_URL=http://localhost:3001

# --- Push (Firebase service account JSON; leave empty to use the dev stub) --
FCM_CREDENTIALS_JSON=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=

# --- Business time zone (due dates, scheduled jobs) ------------------------
TZ_BUSINESS=Asia/Bangkok
