{
  "$comment": "สูตรคำนวณตั้งต้น (M06 §3) — ห้องปฏิบัติการต้องยืนยันกับ SOP ก่อนใช้งานจริง; testVectors ใช้เป็น unit test ของ formula engine",
  "formulas": [
    {
      "code": "BOD5_SEEDED",
      "version": 1,
      "name": "BOD5 (มีการเติมเชื้อ) — SM 5210 B",
      "expression": "((D1 - D2) - S * Vs) / P",
      "outputUnit": "mg/L",
      "inputs": [
        {
          "key": "D1",
          "label": "DO เริ่มต้น",
          "unit": "mg/L",
          "required": true
        },
        {
          "key": "D2",
          "label": "DO หลังบ่ม 5 วัน",
          "unit": "mg/L",
          "required": true
        },
        {
          "key": "S",
          "label": "ออกซิเจนที่เชื้อใช้ต่อ mL เชื้อ",
          "unit": "mg/L per mL",
          "required": true
        },
        {
          "key": "Vs",
          "label": "ปริมาตรเชื้อในขวด",
          "unit": "mL",
          "required": true
        },
        {
          "key": "P",
          "label": "สัดส่วนปริมาตรตัวอย่าง (ทศนิยม)",
          "unit": "-",
          "required": true
        }
      ],
      "validations": [
        {
          "expr": "D1 - D2 >= 2",
          "message": "DO ลดลงน้อยกว่า 2.0 mg/L — dilution นี้ใช้ไม่ได้",
          "severity": "ERROR"
        },
        {
          "expr": "D2 >= 1",
          "message": "DO คงเหลือน้อยกว่า 1.0 mg/L — dilution นี้ใช้ไม่ได้",
          "severity": "ERROR"
        }
      ],
      "testVectors": [
        {
          "inputs": {
            "D1": 8.5,
            "D2": 4.3,
            "S": 0.1,
            "Vs": 2,
            "P": 0.1
          },
          "expected": "40"
        },
        {
          "inputs": {
            "D1": 8.5,
            "D2": 8.0,
            "S": 0.1,
            "Vs": 2,
            "P": 0.1
          },
          "expectedError": "D1 - D2 >= 2"
        }
      ]
    },
    {
