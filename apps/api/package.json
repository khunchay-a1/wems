{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "WEMS API (NestJS) — HTTP server (src/main.ts) + worker (src/worker.ts)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "prisma": "prisma",
    "cli": "tsx src/cli.ts",
    "openapi": "node dist/openapi.js"
  },
  "prisma": {},
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.5",
    "handlebars": "4.7.9",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.13",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@wems/config": "workspace:*",
    "busboy": "1.6.0",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "mailparser": "3.9.33",
    "pino-pretty": "13.1.3",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "smtp-server": "3.19.16",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
